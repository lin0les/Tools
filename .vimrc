" C syntax
syntax on
filetype plugin indent on

" Line numbers
set number

" Indentation
set tabstop=4
set shiftwidth=4
set softtabstop=4
set expandtab

" Auto indentation
set autoindent
set smartindent

" Search
set hlsearch
set incsearch

" Better editing
set showmatch
set cursorline

" Don't create swap/backup files
set nobackup
set noswapfile
